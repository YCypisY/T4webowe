<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        mc:Ignorable="d"
        Title="Nadaj przesyłkę, Cyprian Ciepliński" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Width="500" Height="350" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel Width="250" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <GroupBox Header="Rodzaj przesyłki" Width="230" Margin="10">
                        <StackPanel>
                            <RadioButton Name="opcjaPocztowka" Margin="10" Content="Pocztówka" GroupName="opcja" IsChecked="True"/>

                            <RadioButton Name="opcjaList" Margin="10" Content="List" GroupName="opcja"/>

                            <RadioButton Name="opcjaPaczka" Margin="10" Content="Paczka" GroupName="opcja"/>
                        </StackPanel>
                    </GroupBox>
                    <Button x:Name="btnSprawdzCene" Content="sprawdź cenę" Width="230" Height="30" Margin="10" Click="btnSprawdzCene_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="zdjecie" Width="100" Height="100" Margin="10" Source="/egz-images/pocztowka.jpg"/>
                        <TextBlock Text="Cena: 1 zł" x:Name="txtcena" Width="100" Height="20" FontWeight="Bold" FontSize="15" Margin="10" VerticalAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Width="250" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <GroupBox Header="Dane adresowe" Width="210" Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Label Content="Ulica z numerem" Margin="10,5,10,0"/>
                            <TextBox x:Name="txbUlica" Width="160" Height="20" FontSize="12" Margin="10,0,10,0"/>
                            <Label Content="Kod pocztowy" Margin="10,5,10,0"/>
                            <TextBox x:Name="txbKod" Width="160" Height="20" FontSize="12" Margin="10,0,10,0"/>
                            <Label Content="Miasto" Margin="10,5,10,0"/>
                            <TextBox x:Name="txbmiasto" Width="160" Height="20" FontSize="12" Margin="10,0,10,10"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </StackPanel>
            <Button Name="btnZatwierdz" Width="500" Height="30" Content="Zatwierdź" Margin="10" Click="btnZatwierdz_Click"/>
        </StackPanel>
      
    </Grid>
</Window>
